---
// src/components/Sections/Home/PopularLabs.astro - selected hands-on labs on the Home page.
import LabCard from "@components/Cards/LabCard.astro";
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";
import type { ResolvedLab } from "@js/labs";

type Props = {
  labs: ResolvedLab[];
};

const { labs } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);
---

<section class="container-page py-16 md:py-24" aria-labelledby="popular-labs-title" data-slot="popular-labs">
  <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-primary">
    {t.home.labsEyebrow}
  </p>

  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
    <SectionHeader
      as="h2"
      headingId="popular-labs-title"
      title={t.home.labsTitle}
      lede={t.home.labsLede}
      class="sm:flex-1"
    />

    <Button href={routes.labs} variant="ghost" size="md" class="shrink-0 self-start sm:self-auto">
      {t.home.labsCta}
      <Icon name="arrow-right" size={17} />
    </Button>
  </div>

  <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      labs.map((entry) => (
        <li class="flex">
          <LabCard {entry} {locale} as="h3" class="w-full" />
        </li>
      ))
    }
  </ul>
</section>
