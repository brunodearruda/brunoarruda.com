---
// src/components/Sections/Home/Hero.astro - primary Home introduction for Bruno Arruda.
import heroImage from "../../../assets/bruno-arruda-cloud-security-hero.jpg";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";
import { Image } from "astro:assets";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);
---

<div class="bg-background p-2 sm:p-3 md:p-4" data-slot="home-hero">
  <section
    class="deep-scene rounded-panel relative isolate overflow-hidden"
    aria-labelledby="hero-title"
    data-deep-scene
  >
    <Image
      src={heroImage}
      alt=""
      widths={[720, 1200, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 size-full object-cover object-[center_62%]"
      aria-hidden="true"
    />

    <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/30"
      aria-hidden="true"
    >
    </div>

    <div
      class="container-page relative z-10 flex min-h-[60svh] flex-col justify-start pt-28 pb-14 sm:pt-32 md:pt-36 md:pb-16 lg:pt-36 lg:pb-16"
    >
      <div class="max-w-[36rem]">
  <p
    class="flex items-center gap-3 text-xs font-medium tracking-[0.18em] text-white/80 uppercase"
  >
    <span
      class="bg-primary inline-block h-px w-8 shrink-0"
      aria-hidden="true"
    ></span>
    {t.home.eyebrow}
  </p>

  <h1
    id="hero-title"
    class="font-display text-display-lg lg:text-display-xl mt-6 whitespace-pre-line text-white"
  >
    {t.home.heroTitle}
  </h1>

  <p class="mt-7 max-w-[34rem] leading-relaxed text-white/85 md:text-lg">
    {t.home.heroLede}
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <Button href={routes.posts} variant="primary" size="lg">
      {t.home.heroPrimary}
      <Icon name="arrow-right" size={18} />
    </Button>

    <Button href={routes.labs} variant="outline" size="lg">
      <Icon name="flask" size={18} />
      {t.home.heroSecondary}
    </Button>
  </div>

  <div class="mt-10 border-t border-white/25 pt-6">
    <p class="text-xs font-semibold tracking-[0.18em] text-white/70 uppercase">
      {t.home.heroSupport}
    </p>
  </div>
</div>

   <div
  class="absolute top-[22%] right-8 hidden border-l border-white/35 pl-5 xl:block 2xl:right-12"
  aria-hidden="true"
>
  <p
    class="max-w-[9rem] font-display text-sm font-semibold leading-[1.75] tracking-[0.18em] text-white/70 uppercase"
  >
    Cloud<br />
    Security<br />
    for a more<br />
    resilient<br />
    tomorrow.
  </p>
</div>   

    </div>
  </section>
</div>

<style>
  .hero-veil {
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.88) 0%,
      rgb(0 0 0 / 0.6) 42%,
      rgb(0 0 0 / 0) 80%
    );
  }

  @media (max-width: 63.99rem) {
    .hero-veil {
      background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--reef-background) 82%, transparent) 0%,
        color-mix(in oklab, var(--reef-background) 90%, transparent) 55%,
        color-mix(in oklab, var(--reef-background) 72%, transparent) 100%
      );
    }
  }
</style>