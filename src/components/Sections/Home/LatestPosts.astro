---
// src/components/Sections/Home/LatestPosts.astro - latest published articles on the Home page.
import PostCard from "@components/Cards/PostCard.astro";
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";
import type { ResolvedPost } from "@js/posts";

type Props = {
  posts: ResolvedPost[];
};

const { posts } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);
---

<section class="bg-surface border-border border-y" aria-labelledby="latest-title" data-slot="latest-posts">
  <div class="container-page py-16 md:py-24">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-primary">
      {t.home.latestEyebrow}
    </p>

    <SectionHeader
      as="h2"
      headingId="latest-title"
      title={t.home.latestTitle}
      lede={t.home.latestLede}
    />

    <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((entry) => (
          <li class="flex">
            <PostCard {entry} {locale} as="h3" class="w-full" />
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-end">
      <Button href={routes.posts} variant="outline" size="lg">
        {t.home.latestCta}
        <Icon name="arrow-right" size={18} />
      </Button>
    </div>
  </div>
</section>
