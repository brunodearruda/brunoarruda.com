---
// src/components/Sections/Home/StudioNote.astro - Home positioning statement for Bruno Arruda.
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);
---

<section
  class="deep-scene relative overflow-hidden bg-ink"
  aria-labelledby="studio-title"
  data-slot="studio-note"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    aria-hidden="true"
    style="background: radial-gradient(circle at 80% 50%, color-mix(in srgb, var(--color-primary) 22%, transparent), transparent 45%);"
  >
  </div>

  <div class="container-page relative py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-primary">
        {t.home.aboutEyebrow}
      </p>

      <h2
        id="studio-title"
        class="font-display whitespace-pre-line text-4xl font-semibold leading-tight tracking-tight text-white md:text-5xl"
      >
        {t.home.aboutTitle}
      </h2>

      <p class="mt-6 max-w-2xl text-base leading-7 text-white/75 md:text-lg">
        {t.home.aboutLede}
      </p>

      <div class="mt-8">
        <Button href={routes.about} variant="primary" size="md">
          {t.home.aboutCta}
          <Icon name="arrow-right" size={17} />
        </Button>
      </div>
    </div>
  </div>
</section>