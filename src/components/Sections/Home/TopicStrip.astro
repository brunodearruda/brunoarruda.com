---
// src/components/Sections/Home/TopicStrip.astro - approved Cloud Security topic taxonomy on the Home page.
import TopicCard from "@components/Cards/TopicCard.astro";
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import type { CollectionEntry } from "astro:content";

type Props = {
  topics: CollectionEntry<"topics">[];
};

const { topics } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

const rest = topics.length % 3;
const tail = rest === 0 ? 0 : rest === 2 ? 2 : Math.min(topics.length, 4);
const firstWide = topics.length - tail;
---

<section class="container-page py-16 md:py-24" aria-labelledby="topics-title" data-slot="topic-strip">
  <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-primary">
    {t.home.topicsEyebrow}
  </p>

  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
    <SectionHeader
      as="h2"
      headingId="topics-title"
      title={t.home.topicsTitle}
      lede={t.home.topicsLede}
      class="sm:flex-1"
    />

    <Button href={routes.topics} variant="ghost" size="md" class="shrink-0 self-start sm:self-auto">
      {t.home.topicsCta}
      <Icon name="arrow-right" size={17} />
    </Button>
  </div>

  <ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-6">
    {
      topics.map((topic, i) => {
        const slug = entrySlug(topic.id);

        return (
          <li class:list={["flex", i >= firstWide ? "lg:col-span-3" : "lg:col-span-2"]}>
            <TopicCard
              {topic}
              {locale}
              href={`${routes.topics}${slug}/`}
              class="w-full"
            />
          </li>
        );
      })
    }
  </ul>
</section>