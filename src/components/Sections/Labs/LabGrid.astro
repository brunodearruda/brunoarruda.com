---
// src/components/Sections/Labs/LabGrid.astro - grid of published technical labs.

import LabCard from "@components/Cards/LabCard.astro";
import { useTranslations, type Locale } from "@i18n";
import type { ResolvedLab } from "@js/labs";
import EmptyState from "@components/Sections/Archive/EmptyState.astro";

type Props = {
  labs: ResolvedLab[];
  locale: Locale;
  heading?: string;
  headingLevel?: "h2" | "h3";
  class?: string;
};

const {
  labs,
  locale,
  heading,
  headingLevel = "h2",
  class: className,
}: Props = Astro.props;

const t = useTranslations(locale);
---

<section
  class:list={["container-page py-14 md:py-20", className]}
  data-slot="lab-grid"
>
  {
    labs.length === 0 ? (
      <EmptyState
        title={t.labs.emptyTitle}
        description={t.labs.emptyLede}
        icon="code"
      />
    ) : (
      <Fragment>
        {heading && (
          <h2 class="font-display text-foreground mb-8 text-2xl font-semibold tracking-tight">
            {heading}
          </h2>
        )}
        <ul
          class="grid grid-cols-1 gap-6 md:grid-cols-2"
          aria-label={t.labs.listLabel}
        >
          {labs.map((entry) => (
            <li class="flex">
              <LabCard
                {entry}
                {locale}
                as={headingLevel}
                class="w-full"
              />
            </li>
          ))}
        </ul>
      </Fragment>
    )
  }
</section>
