---
// src/components/Sections/Labs/LabHero.astro - en-tete editorial d'un Lab : contexte, metadonnees, preuves, auteur et dates.

import { Icon } from "@components/svg/icons";
import { Avatar } from "@components/ui/avatar";
import { Badge } from "@components/ui/badge";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { fmt, formatDate, getLocale, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import { readingTime } from "@js/textUtils";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  lab: CollectionEntry<"labs">;
  author: CollectionEntry<"authors">;
  topic: CollectionEntry<"topics">;
  class?: string;
};

const { lab, author, topic, class: className } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

const {
  title,
  description,
  pubDate,
  updatedDate,
  awsServices,
  heroServices,
  securityControls,
  heroSecurityControls,
  github,
  video,
  cover,
  coverAlt,
  draft,
} = lab.data;

const displayedServices = heroServices ?? awsServices.slice(0, 6);
const displayedSecurityControls = heroSecurityControls ?? securityControls.slice(0, 6);

const topicHref = `${routes.topics}${entrySlug(topic.id)}/`;
const authorHref = routes.about;
const { minutes } = readingTime(lab.body ?? "");
const readingLabel = minutes === 1 ? t.post.minReadOne : fmt(t.post.minRead, { n: minutes });

const iso = (date: Date): string => date.toISOString();
---

<header class:list={["pt-28 pb-10 md:pt-36 md:pb-12", className]} data-slot="lab-hero">
  <div class="container-page">
    <div class="measure-prose mx-auto flex flex-col">
      <p class="mb-4 flex flex-wrap items-center gap-3">
        <span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>

        <span
          class="font-sans text-primary text-xs font-semibold tracking-[0.18em] uppercase"
        >
          {t.lab.eyebrow}
        </span>

        <span class="text-muted-foreground" aria-hidden="true">·</span>

        <a
          href={topicHref}
          class="font-sans text-muted-foreground hover:text-foreground text-xs font-medium tracking-[0.18em] uppercase transition-colors duration-150"
        >
          {topic.data.name}
        </a>

        {draft && <Badge variant="outline">{t.lab.draft}</Badge>}
      </p>

      <h1
        class="font-display text-display-sm md:text-display-md text-foreground"
        transition:name={`lab-title-${entrySlug(lab.id)}`}
      >
        {title}
      </h1>

      <p class="text-muted-foreground mt-5 text-xl leading-[1.55] font-normal md:text-2xl md:leading-[1.5]">
        {description}
      </p>

      {
        (displayedServices.length > 0 || displayedSecurityControls.length > 0) && (
          <dl class="border-border mt-8 grid gap-5 border-t pt-6 md:grid-cols-2 md:gap-8">
            {displayedServices.length > 0 && (
              <div>
                <dt class="text-muted-foreground mb-2 font-sans text-xs font-semibold tracking-[0.16em] uppercase">
                  {t.lab.awsServices}
                </dt>
                <dd class="text-foreground/85 font-sans text-sm leading-relaxed">
                  {displayedServices.join(" · ")}
                </dd>
              </div>
            )}

            {displayedSecurityControls.length > 0 && (
              <div>
                <dt class="text-muted-foreground mb-2 font-sans text-xs font-semibold tracking-[0.16em] uppercase">
                  {t.lab.securityFocus}
                </dt>
                <dd class="text-foreground/85 font-sans text-sm leading-relaxed">
                  {displayedSecurityControls.join(" · ")}
                </dd>
              </div>
            )}
          </dl>
        )
      }

      <div class="border-border mt-8 flex flex-wrap items-center gap-x-5 gap-y-4 border-t pt-5">
        <div class="flex items-center gap-3">
          <Avatar name={author.data.name} src={author.data.avatar?.src} size="md" alt="" />

          <span class="flex flex-col">
            <a
              href={authorHref}
              class="text-foreground decoration-primary/50 font-sans text-sm font-medium underline-offset-4 hover:underline"
            >
              {author.data.name}
            </a>

            <span class="text-muted-foreground font-sans text-xs">
              {author.data.role}
            </span>
          </span>
        </div>

        <p class="text-muted-foreground flex flex-wrap items-center gap-x-5 gap-y-1 font-sans text-sm">
          <span>
            {t.post.published}{" "}
            <time datetime={iso(pubDate)} class="text-foreground">
              {formatDate(pubDate, locale)}
            </time>
          </span>

          {
            updatedDate && (
              <span title={t.post.updatedNote}>
                {t.post.updated}{" "}
                <time datetime={iso(updatedDate)} class="text-foreground">
                  {formatDate(updatedDate, locale)}
                </time>
              </span>
            )
          }

          <span>{readingLabel}</span>
        </p>
      </div>

      {
        (github || video) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {github && (
              <Button
                href={github}
                reload
                target="_blank"
                rel="noopener noreferrer"
                variant="outline"
                size="md"
              >
                {t.lab.viewGithub}
                <Icon name="arrow-up-right" size={16} />
                <span class="sr-only">({t.common.newTab})</span>
              </Button>
            )}

            {video && (
              <Button
                href={video}
                reload
                target="_blank"
                rel="noopener noreferrer"
                variant="outline"
                size="md"
              >
                {t.lab.watchVideo}
                <Icon name="arrow-up-right" size={16} />
                <span class="sr-only">({t.common.newTab})</span>
              </Button>
            )}
          </div>
        )
      }

      {
        draft && (
          <p class="border-border bg-muted text-muted-foreground rounded-card mt-6 border p-4 font-sans text-sm leading-relaxed">
            {t.lab.draftNote}
          </p>
        )
      }
    </div>
  </div>

  {
    cover && (
      <figure class="container-page mt-10 md:mt-12">
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 80rem) 72rem, 100vw"
          class="rounded-card shadow-float measure-wide mx-auto w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }
</header>
