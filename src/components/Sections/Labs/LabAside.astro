---
// src/components/Sections/Labs/LabAside.astro - aparte editorial discret pour une menace, une decision ou un compromis dans un Lab.
import { getLocale, useTranslations } from "@i18n";

type AsideType = "threat" | "decision" | "tradeoff";

type Props = {
  type: AsideType;
  class?: string;
};

const { type, class: className } = Astro.props;
const t = useTranslations(getLocale(Astro));

const labels: Record<AsideType, string> = {
  threat: t.lab.asideThreat,
  decision: t.lab.asideDecision,
  tradeoff: t.lab.asideTradeoff,
};

const label = labels[type];
---

<aside
  class:list={["lab-aside", className]}
  data-slot="lab-aside"
  data-type={type}
  aria-label={label}
>
  <span class="lab-aside-label">{label}</span>
  <div class="lab-aside-content">
    <slot />
  </div>
</aside>

<style>
  .lab-aside {
    margin-block: 0 var(--prose-flow);
    padding-block: 0.2rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--color-border);
  }

  .lab-aside[data-type="threat"] {
    border-inline-start-color: var(--color-accent);
  }

  .lab-aside[data-type="decision"] {
    border-inline-start-color: var(--color-primary);
  }

  .lab-aside-label {
    display: block;
    margin-block-end: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .lab-aside[data-type="threat"] .lab-aside-label {
    color: var(--color-accent-text);
  }

  .lab-aside[data-type="decision"] .lab-aside-label {
    color: var(--color-primary);
  }

  .lab-aside-content :global(> :last-child) {
    margin-block-end: 0;
  }
</style>
