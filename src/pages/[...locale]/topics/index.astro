---
// src/pages/[...locale]/topics/index.astro - l'index des sujets et leurs ressources publiees.
import TopicCard from "@components/Cards/TopicCard.astro";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, localePaths, localizePath, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import { getResolvedLabs } from "@js/labs";
import { getResolvedPosts, getSortedTopics } from "@js/posts";
import { breadcrumbList } from "@js/schema";
import { topicContentFor } from "@js/topics";
import BaseLayout from "@layouts/BaseLayout.astro";

export const getStaticPaths = localePaths;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

const [topics, posts, labs] = await Promise.all([
  getSortedTopics(locale),
  getResolvedPosts(locale),
  getResolvedLabs(locale),
]);

const title = t.topics.metaTitle;
const description = t.topics.metaDescription;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.topics.breadcrumb, url: new URL(localizePath("/topics/", locale), base).href },
]);

// Voir le commentaire de la grille plus bas : les dernieres cartes s'elargissent
// pour remplir la rangee. Zero, deux ou quatre selon ce que laisse la division.
const rest = topics.length % 3;
const tail = rest === 0 ? 0 : rest === 2 ? 2 : Math.min(topics.length, 4);
const firstWide = topics.length - tail;
---

<BaseLayout
  {title}
  {description}
  image={{
    src: "/og/topics.png",
    alt: "Bruno Arruda | Cloud Security Topics",
  }}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      eyebrow={t.topics.eyebrow}
      title={t.topics.title}
      accentWord={t.topics.accent}
      lede={t.topics.lede}
      crumbs={[{ label: t.topics.breadcrumb }]}
    />

    <section class="container-page py-14 md:py-20" aria-label={t.topics.allTopics}>
      {/* Meme regle que la bande de l'accueil : trois cartes par rangee sur une
          grille de six colonnes, et le reste de la division elargit les
          dernieres cartes au lieu de partir au centre. Ni trou a droite, ni
          rangee orpheline au milieu. */}
      <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-6">
        {
          topics.map((topic, i) => {
            const slug = entrySlug(topic.id);
            const content = topicContentFor(slug, posts, labs);
            return (
              <li class:list={["flex", i >= firstWide ? "lg:col-span-3" : "lg:col-span-2"]}>
                <TopicCard
                  {topic}
                  {locale}
                  href={`${routes.topics}${slug}/`}
                  count={content.totalCount}
                  as="h2"
                  class="w-full"
                />
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>

  <Footer />
</BaseLayout>
