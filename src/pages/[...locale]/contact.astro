---
// src/pages/[...locale]/contact.astro - contact page for professional connections and enquiries.

import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import siteData from "@config/siteData.json";
import { getLocale, localePaths, localizePath, useTranslations } from "@i18n";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";

export const getStaticPaths = localePaths;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const title = t.contact.metaTitle;
const description = t.contact.metaDescription;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.contact.metaTitle, url: new URL(localizePath("/contact/", locale), base).href },
]);
---

<BaseLayout
  {title}
  {description}
  image={{
    src: "/og/contact.png",
    alt: "Bruno Arruda | Contact",
  }}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      accentWord={t.contact.accent}
      lede={t.contact.lede}
      crumbs={[{ label: t.contact.breadcrumb }]}
    />

    <div class="container-page py-14 md:py-20">
     <div class="grid gap-6 md:grid-cols-3">

    <!-- EMAIL -->
    <section
      class="border-border bg-surface rounded-card flex flex-col gap-3 border p-7"
      aria-labelledby="email-title"
    >
      <span class="text-primary" aria-hidden="true">
        <Icon name="mail" size={22} />
      </span>

      <h2
        id="email-title"
        class="font-display text-foreground text-xl font-semibold tracking-tight"
      >
        {t.contact.emailTitle}
      </h2>

      <p class="text-muted-foreground text-[0.95rem] leading-relaxed">
        {t.contact.emailLede}
      </p>

      <Button
        href={`mailto:${siteData.author.email}`}
        variant="outline"
        size="md"
        class="mt-auto self-start"
      >
        {t.contact.emailCta}
        <Icon name="arrow-right" size={17} />
      </Button>
    </section>

    <!-- LINKEDIN -->
    <section
      class="border-border bg-surface rounded-card flex flex-col gap-3 border p-7"
      aria-labelledby="linkedin-title"
    >
      <span class="text-primary" aria-hidden="true">
        <Icon name="arrow-up-right" size={22} />
      </span>

      <h2
        id="linkedin-title"
        class="font-display text-foreground text-xl font-semibold tracking-tight"
      >
        {t.contact.linkedinTitle}
      </h2>

      <p class="text-muted-foreground text-[0.95rem] leading-relaxed">
        {t.contact.linkedinLede}
      </p>

      <Button
        href={siteData.author.linkedin}
        variant="outline"
        size="md"
        class="mt-auto self-start"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.contact.linkedinCta}
        <Icon name="arrow-up-right" size={17} />
      </Button>
    </section>

    <!-- GITHUB -->
    <section
      class="border-border bg-surface rounded-card flex flex-col gap-3 border p-7"
      aria-labelledby="github-title"
    >
      <span class="text-primary" aria-hidden="true">
        <Icon name="arrow-up-right" size={22} />
      </span>

      <h2
        id="github-title"
        class="font-display text-foreground text-xl font-semibold tracking-tight"
      >
        {t.contact.githubTitle}
      </h2>

      <p class="text-muted-foreground text-[0.95rem] leading-relaxed">
        {t.contact.githubLede}
      </p>

      <Button
        href={siteData.author.github}
        variant="outline"
        size="md"
        class="mt-auto self-start"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.contact.githubCta}
        <Icon name="arrow-up-right" size={17} />
      </Button>
    </section>

  </div>
</div>
  </main>

  <Footer />
</BaseLayout>
