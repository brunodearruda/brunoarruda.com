---
// src/pages/[...locale]/labs/[id].astro - technical lab detail page with architecture, implementation, validation, and security decisions.

import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import LabFooter from "@components/Sections/Labs/LabFooter.astro";
import LabHero from "@components/Sections/Labs/LabHero.astro";
import PostBody from "@components/Sections/Post/PostBody.astro";
import ReadingProgress from "@components/Sections/Post/ReadingProgress.astro";
import TableOfContents from "@components/Sections/Post/TableOfContents.astro";
import { getSiteRoutes } from "@config/navData.json.ts";
import siteData from "@config/siteData.json";
import { defaultLocale, getLocale, localizePath, useTranslations } from "@i18n";
import { entryLocale, entrySlug } from "@i18n/content";
import { selectMetadataImage } from "@js/metadata";
import { article, breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  // Les brouillons gardent leur vraie route dans le serveur de developpement,
  // mais aucune route n'est emise en production : ils restent donc hors du
  // sitemap construit a partir des pages generees.
  const labs = await getCollection(
    "labs",
    ({ data }) => import.meta.env.DEV || data.draft !== true,
  );

  return Promise.all(
    labs.map(async (lab) => {
      const author = await getEntry(lab.data.author);
      if (!author) {
        throw new Error(`Unknown author "${lab.data.author.id}" in "${lab.id}"`);
      }

      const topic = await getEntry(lab.data.topic);
      if (!topic) {
        throw new Error(`Unknown topic "${lab.data.topic.id}" in "${lab.id}"`);
      }

      const locale = entryLocale(lab.id);

      return {
        params: {
          locale: locale === defaultLocale ? undefined : locale,
          id: entrySlug(lab.id),
        },
        props: { lab, author, topic },
      };
    }),
  );
}

type Props = {
  lab: CollectionEntry<"labs">;
  author: CollectionEntry<"authors">;
  topic: CollectionEntry<"topics">;
};

const { lab, author, topic } = Astro.props;
const { Content, headings } = await render(lab);

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

const base = Astro.site ?? Astro.url;
const url = new URL(`${routes.labs}${entrySlug(lab.id)}/`, base).href;
const siteUrl = new URL("/", base).href;
const personId = new URL("/#person", base).href;
const isSiteAuthor = entrySlug(author.id) === siteData.author.contentId;
const authorUrl = isSiteAuthor ? siteUrl : new URL(routes.about, base).href;
const authorId = isSiteAuthor
  ? personId
  : new URL(`#person-${entrySlug(author.id)}`, authorUrl).href;

const cover = lab.data.cover;
const socialImage = lab.data.socialImage;
const share = selectMetadataImage({
  social: socialImage
    ? { src: socialImage.src, alt: lab.data.socialImageAlt ?? lab.data.title }
    : undefined,
  cover: cover ? { src: cover.src, alt: lab.data.coverAlt ?? lab.data.title } : undefined,
  fallback: siteData.defaultImage,
});

const articleSchema = article({
  type: "TechArticle",
  title: lab.data.title,
  description: lab.data.description,
  url,
  datePublished: lab.data.pubDate,
  dateModified: lab.data.updatedDate,
  image: new URL(share.src, base).href,
  author: {
    id: authorId,
    name: author.data.name,
    url: authorUrl,
    sameAs: author.data.links.map(({ href }) => href),
    jobTitle: author.data.role,
  },
  publisherId: personId,
  articleSection: topic.data.name,
});

const crumbSchema = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.labs.breadcrumb, url: new URL(routes.labs, base).href },
  { name: lab.data.title, url },
]);
---

<BaseLayout
  title={lab.data.title}
  description={lab.data.description}
  type="article"
  noindex={lab.data.draft}
  image={share}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbSchema)} />
  </Fragment>

  <ReadingProgress />
  <Navbar />

  <main id="content" tabindex="-1">
    <article>
      <LabHero {lab} {author} {topic} />

      <PostBody>
        <TableOfContents slot="toc" {headings} desktopDisclosure="active-section" />
        <Content />
      </PostBody>

      <LabFooter {lab} />
    </article>
  </main>

  <Footer />
</BaseLayout>
